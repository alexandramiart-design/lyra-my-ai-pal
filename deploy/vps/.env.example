# --- Base de données locale ---
DB_PASSWORD=CHANGE_ME_DB
DATABASE_URL=postgres://lyra:CHANGE_ME_DB@db:5432/lyra

# --- IA 100 % locale (open source) ---
# Dés que cette variable est définie, l'app n'appelle plus aucun service externe.
LYRA_AI_BASE_URL=http://gateway/v1
LYRA_AI_KEY=local

# Modèle de chat servi par Ollama
LYRA_CHAT_MODEL=qwen2.5:7b-instruct
LYRA_FAST_MODEL=qwen2.5:3b-instruct

# Voix (openedai-speech)
LYRA_TTS_MODEL=tts-1
LYRA_TTS_VOICE=shimmer

# Transcription (faster-whisper)
LYRA_STT_MODEL=Systran/faster-whisper-large-v3

# Images (laisser vide si aucun service d'images installé)
LYRA_IMAGE_MODELS=